{
  "id": "codec-lab",
  "name": { "zh": "编码转换", "en": "Codec Lab" },
  "desc": { "zh": "Base64 / URL / Hex / Unicode / JWT / 时间戳，双向互转", "en": "Base64 / URL / Hex / Unicode / JWT / timestamp, both ways" },
  "version": "1.0.0",
  "category": "dev",
  "author": "Ikaros-521",
  "keywords": ["base64", "url", "hex", "unicode", "jwt", "timestamp", "编码", "解码", "转换"],
  "icon": "icon.svg",
  "defaultEnabled": true,
  "panel": { "script": "panel.js", "style": "panel.css" },
  "actions": [
    { "id": "open", "label": { "zh": "打开编码转换", "en": "Open Codec Lab" }, "method": "openPanel", "hotkey": "Ctrl+Shift+C" }
  ],
  "consumes": ["text/plain", "text/base64", "text/url", "text/jwt", "text/timestamp", "text/hex", "text/unicode"],
  "capabilities": [
    { "id": "timestamp", "type": "text/timestamp", "title": { "zh": "时间戳转换", "en": "Timestamp Convert" } },
    { "id": "jwt", "type": "text/jwt", "title": { "zh": "JWT 解码", "en": "JWT Decode" } },
    { "id": "unicode", "type": "text/unicode", "title": { "zh": "Unicode 转义解码", "en": "Unicode Decode" } },
    { "id": "hex", "type": "text/hex", "title": { "zh": "Hex 十六进制解码", "en": "Hex Decode" } },
    { "id": "base64", "type": "text/base64", "title": { "zh": "Base64 解码", "en": "Base64 Decode" } },
    { "id": "url", "type": "text/url", "title": { "zh": "URL 参数解析", "en": "URL Parse" } }
  ]
}
